{
  "name": "@local/dsh-ide-lsp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Python/TypeScript language servers for the DSH IDE",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-lsp": "0.2.1-rc.5",
    "@deepseek-ai/dsh-lsp-stdio": "0.2.1-rc.5",
    "pyright": "1.1.414",
    "typescript": "^5.0.0",
    "typescript-language-server": "6.0.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
