{
  "name": "@local/dsh-ide",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "内置 IDE：文件树、多标签编辑器、搜索替换与 AI 编程助手",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "assets/codemirror.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
